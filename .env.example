# Copier ce fichier en `.env` (jamais commité) et renseigner les valeurs du projet Supabase :
# Supabase > Project Settings > API (ou Data API).
VITE_SUPABASE_URL=https://votre-projet.supabase.co
# Clé publique (sb_publishable_...) ou clé « anon » historique. JAMAIS la clé service_role.
VITE_SUPABASE_PUBLISHABLE_KEY=
